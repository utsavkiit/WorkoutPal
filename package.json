{
  "name": "workout-pal",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/*.test.ts' 'src/**/*.test.ts'",
    "e2e:build:ios": "detox build --configuration ios.sim.release",
    "e2e:ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 detox test --configuration ios.sim.release",
    "e2e:ios:all": "npm run e2e:build:ios && npm run e2e:ios",
    "e2e:setup:ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 detox build-framework-cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "detox": "^20.51.4",
    "jest": "^29.7.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
